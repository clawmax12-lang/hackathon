# Copy to .env and fill in. .env is gitignored — never commit real values.
# The server loads .env automatically (real environment variables win).
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_WORKSPACE_ID=wrkspc_...      # required: the key is identity-linked
ELEVENLABS_API_KEY=sk_...
FIRECRAWL_API_KEY=                     # optional; plain-fetch discovery works without it
